# Copy to .env (cp .env.example .env) and fill in values. Never commit .env.
# On Replit, set the same variables in Secrets instead (PORT is set by Replit).

# --- Local ports (ignored on Replit, which sets PORT per service) ---
# Vite dev server (the website)
WEB_PORT=5180
# Express API server; Vite proxies /api to this port
API_PORT=5001

# --- Email notifications via Resend ---
# Create at https://resend.com/api-keys with "Sending access". Server-only.
RESEND_API_KEY=
NOTIFY_TO_EMAIL=Atseanpardo@gmail.com
# onboarding@resend.dev only delivers to the Resend account owner's email.
# Switch to an address on a verified domain (e.g. forms@yourdomain.com) for production.
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# --- Optional ---
# Express "trust proxy" setting used to find the visitor IP for rate limiting.
# Defaults to 1 (one proxy hop, right for Replit and the local Vite proxy).
# TRUST_PROXY=1
